GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

EXTENSION_ID="your-extension-id-here"GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"



