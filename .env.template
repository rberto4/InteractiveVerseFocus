# GOOGLE OAUTH CREDENTIALS# ====================================

# ═══════════════════════════════════════════════════════════════════# Docker default (internal network)

# Get from: https://console.cloud.google.com/apis/credentialsDATABASE_URL="postgresql://postgres:postgres@db:5432/interactiverse"

# Create OAuth 2.0 Client ID (Web application)

# Local development alternatives:

GOOGLE_CLIENT_ID="your-google-oauth-client-id"# macOS (Homebrew): postgresql://YOUR_USERNAME@localhost:5432/interactiverse

GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"# Windows/Linux: postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactiverse

GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# ====================================

# ═══════════════════════════════════════════════════════════════════# Google OAuth2 Configuration

# CHROME EXTENSION# ====================================

