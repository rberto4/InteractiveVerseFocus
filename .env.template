# DATABASE CONFIGURATION#

# ═══════════════════════════════════════════════════════════════════# For Docker Setup:

# Configure based on your operating system and PostgreSQL setup#   - Maintainer configures these as GitHub Secrets

#   - CI/CD injects them into Docker images

# 🍎 macOS (Homebrew PostgreSQL - no password required)#   - Team members pull pre-configured images

DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/interactiverse"#

# For Manual Setup:

# 🐧 Linux (Ubuntu/Debian - requires password)#   - Copy to .env in packages/backend/

# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactiverse"#   - Ask maintainer for real values

#   - Or configure your own OAuth/API keys

# 🪟 Windows (requires password)# ====================================

# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactiverse"

