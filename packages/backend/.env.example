# Backend Environment Variables

# Database
# For macOS with Homebrew PostgreSQL (no password required):
DATABASE_URL="postgresql://YOUR_USERNAME@localhost:5432/interactiverse"
# Replace YOUR_USERNAME with your Mac username (run: whoami)
#
# For PostgreSQL with password:
# DATABASE_URL="postgresql://user:password@localhost:5432/interactiverse"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenRouter API
OPENROUTER_API_KEY="your-openrouter-api-key"

# Server
PORT=3000
NODE_ENV="development"
