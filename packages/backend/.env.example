# Backend Environment Variables

# ═══════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# 🍎 macOS (Homebrew PostgreSQL - no password required)
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/interactiverse"
# Replace YOUR_MAC_USERNAME with output of: whoami

# 🐧 Linux (Ubuntu/Debian - default postgres user)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactiverse"

# 🪟 Windows (always requires password)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/interactiverse"

# 🐳 Docker (any OS)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interactiverse"

# ☁️ Cloud/Production (add ?sslmode=require)
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# ═══════════════════════════════════════════════════════════════════
# GOOGLE OAUTH CREDENTIALS
# ═══════════════════════════════════════════════════════════════════
# Get from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# ═══════════════════════════════════════════════════════════════════
# CHROME EXTENSION
# ═══════════════════════════════════════════════════════════════════
# Get Extension ID from chrome://extensions after installing

EXTENSION_ID="your-extension-id-here"
EXTENSION_REDIRECT_URL="https://your-extension-id-here.chromiumapp.org/"

# ═══════════════════════════════════════════════════════════════════
# JWT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Generate secure secret with: openssl rand -base64 32

JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# ═══════════════════════════════════════════════════════════════════
# OPENROUTER API
# ═══════════════════════════════════════════════════════════════════
# Get free API key from: https://openrouter.ai/

OPENROUTER_API_KEY="your-openrouter-api-key"

# ═══════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

PORT=3000
NODE_ENV="development"
